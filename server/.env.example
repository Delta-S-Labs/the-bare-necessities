# Copy to .env for local development (optional).
#
# With no DATABASE_URL the server uses an IN-MEMORY store — handy for local
# testing, but it does NOT persist across restarts. Set DATABASE_URL for
# anything real.

PORT=3000

# Postgres connection string (Render / Neon / Supabase). Empty = in-memory dev.
DATABASE_URL=

# Set to "true" only if your Postgres requires SSL (most external/hosted URLs
# do; Render's INTERNAL connection string does not).
DATABASE_SSL=false

# Secret that guards the admin endpoints:
#   GET /api/waitlist, /api/waitlist/count, /api/waitlist/export.csv
ADMIN_TOKEN=change-me

# Comma-separated list of site origins allowed to POST to the API.
# Empty = allow any origin (fine for local dev; set this in production).
# e.g. ALLOWED_ORIGINS=https://thebarenecessities.app,https://www.thebarenecessities.app
ALLOWED_ORIGINS=
